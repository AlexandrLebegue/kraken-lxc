#!/opt/pipx/venvs/liquidctl/bin/python
"""Compteur de notifications affiché sur l'écran du Kraken.

Usage : kl-notify add [n] | clear | count
"""
import sys

sys.path.insert(0, "/opt/kraken-lxc")
from kraken_lxc import notify  # noqa: E402

cmd = sys.argv[1] if len(sys.argv) > 1 else "count"
if cmd == "add":
    print(notify.add(int(sys.argv[2]) if len(sys.argv) > 2 else 1))
elif cmd == "clear":
    print(notify.clear())
elif cmd == "count":
    print(notify.count())
else:
    sys.exit(__doc__)
